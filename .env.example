# Supabase injects SUPABASE_URL and default API keys into Edge Functions automatically.
# Do not create custom SUPABASE_* secrets. The function supports legacy and new key formats.
# Configure only the application/provider values below in Edge Function Secrets.
ALLOWED_ORIGIN=https://YOUR_PUBLIC_SITE_DOMAIN
MSG91_AUTH_KEY=YOUR_MSG91_AUTH_KEY
MSG91_TEMPLATE_APPROVED=YOUR_APPROVED_FLOW_TEMPLATE_ID
MSG91_TEMPLATE_REJECTED=YOUR_REJECTED_FLOW_TEMPLATE_ID
WHATSAPP_ACCESS_TOKEN=YOUR_LONG_LIVED_TOKEN
WHATSAPP_PHONE_NUMBER_ID=YOUR_PHONE_NUMBER_ID
WHATSAPP_TEMPLATE_APPROVED=appointment_confirmation
WHATSAPP_TEMPLATE_REJECTED=appointment_request_update
WHATSAPP_TEMPLATE_HANDOFF=appointment_confirmation
WHATSAPP_TEMPLATE_LANGUAGE=en
WHATSAPP_API_VERSION=v26.0
CLINIC_PHONE_MANSOOR_PRIVATE=+919906927006
CLINIC_PHONE_GMC_ANANTNAG=SET_VERIFIED_CLINIC_PHONE
CLINIC_PHONE_SOUTH_KASHMIR=SET_VERIFIED_CLINIC_PHONE
